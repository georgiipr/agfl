+"""Token-energy invariants; target-machine tests, never a launch prerequisite."""
+import pytest
+import torch
+
+from agfl.attention.agfl.layer import AGFL, GraphFilter, token_energy_features
+from tests.test_agfl_token_routing import nonzero_gate, settings
+
+
+def energy_filter(dim=3, **updates):
+    return GraphFilter(dim, settings(coefficient_conditioning='token_energy', **updates)).double()
+
+
+def activate_energy(module):
+    nonzero_gate(module)
+    with torch.no_grad():
+        w = torch.arange(module.energy_gate.weight.numel(), dtype=module.energy_gate.weight.dtype,
+                         device=module.energy_gate.weight.device)
+        module.energy_gate.weight.copy_(torch.cos(w * .7).reshape_as(module.energy_gate.weight) * .2)
+
+
+@pytest.mark.parametrize('variant', ['polynomial', 'renormalized'])
+@pytest.mark.parametrize('projection', ['none', 'shared', 'separate'])
+def test_energy_zero_init_preserves_token_function_rng_keys_and_shared_gradients(variant, projection):
+    options = settings(coefficient_conditioning='token_contrast', agfl_variant=variant,
+                       filter_projection=projection)
+    torch.manual_seed(319)
+    control = AGFL(options).double()
+    control_rng = torch.get_rng_state().clone()
+    torch.manual_seed(319)
+    candidate = AGFL({**options, 'coefficient_conditioning': 'token_energy'}).double()
+    assert torch.equal(torch.get_rng_state(), control_rng)
+    assert set(candidate.state_dict()) - set(control.state_dict()) == {
+        f'filters.{h}.energy_gate.weight' for h in range(4)}
+    assert sum(p.numel() for p in candidate.parameters()) - sum(p.numel() for p in control.parameters()) == 24
+    for name, value in control.state_dict().items():
+        torch.testing.assert_close(candidate.state_dict()[name], value, rtol=0, atol=0)
+    # Equivalence also holds when the original G has learned nonzero weights.
+    for original, new in zip(control.filters, candidate.filters):
+        nonzero_gate(original)
+        with torch.no_grad():
+            new.coefficient_gate.weight.copy_(original.coefficient_gate.weight)
+    x = torch.randn(2, 7, 32, dtype=torch.float64)
+    left, right = x.clone().requires_grad_(), x.clone().requires_grad_()
+    expected, actual = control(left), candidate(right)
+    torch.testing.assert_close(actual, expected, rtol=0, atol=0)
+    upstream = torch.randn_like(actual)
+    (expected * upstream).sum().backward()
+    (actual * upstream).sum().backward()
+    torch.testing.assert_close(left.grad, right.grad, rtol=1e-10, atol=1e-11)
+    for name, p in control.named_parameters():
+        gradient = dict(candidate.named_parameters())[name].grad
+        if p.grad is None:
+            assert gradient is None
+        else:
+            torch.testing.assert_close(gradient, p.grad, rtol=1e-10, atol=1e-11)
+    assert all(torch.isfinite(f.energy_gate.weight.grad).all()
+               and torch.count_nonzero(f.energy_gate.weight.grad) > 0 for f in candidate.filters)
+
+
+def test_energy_formula_and_signed_polynomial_match_independent_calculation():
+    module = energy_filter()
+    activate_energy(module)
+    v = torch.tensor([[[1., -2., .5], [4., .2, -1.], [-.1, 3., 2.]]], dtype=torch.float64)
+    a = torch.tensor([[[.6, .3, .1], [.2, .7, .1], [.1, .2, .7]]], dtype=torch.float64)
+    p1, p2 = a @ v, a @ (a @ v)
+    e, f = v.square().sum(-1) / 3, p1.square().sum(-1) / 3
+    log_e = (e + 1e-6).log()
+    c = (p1 - v).square().sum(-1) / 3 / (2 * (e + f) + 1e-6)
+    r = torch.stack(((log_e - log_e.mean(-1, keepdim=True)).tanh(),
+                     c - c.mean(-1, keepdim=True)), -1)
+    def normalize(x):
+        centered = x - x.mean(-1, keepdim=True)
+        return centered / (centered.square().mean(-1, keepdim=True) + 1e-5).sqrt()
+    d = torch.cat((normalize(v), normalize(p1 - v)), -1)
+    u = (d @ module.coefficient_gate.weight.T + r @ module.energy_gate.weight.T).tanh()
+    alpha = module.alpha_logits + .25 * (u - u.mean(-1, keepdim=True))
+    expected = sum(alpha[..., k, None] * p for k, p in enumerate((v, p1, p2)))
+    torch.testing.assert_close(token_energy_features(v, p1), r, rtol=1e-12, atol=1e-12)
+    torch.testing.assert_close(module.coefficient_values(v, a), alpha, rtol=1e-12, atol=1e-12)
+    torch.testing.assert_close(module(a, v), expected, rtol=1e-12, atol=1e-12)
+    delta = alpha - module.alpha_logits
+    assert delta.abs().max() <= 1/3 and delta.min() < 0 < delta.max()
+    torch.testing.assert_close(delta.sum(-1), torch.zeros_like(e), rtol=0, atol=1e-12)
+    assert r.abs().max() <= 1
+    # Centering occurs before energy tanh; only contrast is guaranteed zero mean afterward.
+    torch.testing.assert_close(r[..., 1].mean(-1), torch.zeros(1, dtype=torch.float64), atol=1e-12, rtol=0)
+
+
+@pytest.mark.parametrize('variant', ['polynomial', 'renormalized'])
+def test_energy_routing_is_trial_independent_token_equivariant_and_differentiable(variant):
+    torch.manual_seed(320)
+    module = energy_filter(agfl_variant=variant)
+    activate_energy(module)
+    v = torch.randn(2, 3, 3, dtype=torch.float64)
+    scores = torch.randn(2, 3, 3, dtype=torch.float64)
+    a = scores.softmax(-1)
+    expected = module(a, v)
+    changed = v.clone(); changed[1] *= 100
+    torch.testing.assert_close(module(a, changed)[:1], expected[:1], atol=1e-12, rtol=1e-12)
+    torch.testing.assert_close(module(a[:1], v[:1]), expected[:1], atol=1e-12, rtol=1e-12)
+    order = torch.tensor([2, 0, 1])
+    torch.testing.assert_close(module(a[:, order][:, :, order], v[:, order]), expected[:, order], atol=1e-12, rtol=1e-12)
+    assert torch.autograd.gradcheck(lambda x, s: module(s.softmax(-1), x),
+                                   (v.requires_grad_(), scores.requires_grad_()), atol=1e-5, rtol=1e-3)
+
+
+@pytest.mark.parametrize('dtype', [torch.float16, torch.bfloat16, torch.float32, torch.float64])
+def test_energy_descriptor_zero_and_large_inputs_remain_finite(dtype):
+    v = torch.tensor([[[0., 0.], [60000., -60000.], [30000., -30000.]]], dtype=dtype, requires_grad=True)
+    first = -v
+    r = token_energy_features(v, first)
+    assert r.dtype == (torch.float64 if dtype == torch.float64 else torch.float32)
+    assert torch.isfinite(r).all() and r.abs().max() <= 1
+    r.square().sum().backward()
+    assert torch.isfinite(v.grad).all()
+    zero = torch.zeros(2, 3, 4, dtype=dtype, requires_grad=True)
+    output = token_energy_features(zero, zero)
+    torch.testing.assert_close(output, torch.zeros_like(output), rtol=0,
+                               atol=1e-12 if dtype == torch.float64 else 2e-6)
+    output.sum().backward()
+    assert torch.isfinite(zero.grad).all()
+
+
+def test_local_energy_detects_magnitude_and_constant_tokens_have_zero_descriptor():
+    v = torch.tensor([[[1., -1.], [2., -2.], [4., -4.]]], dtype=torch.float64)
+    r = token_energy_features(v, v)
+    assert r[0, 0, 0] < r[0, 1, 0] < r[0, 2, 0]
+    assert torch.count_nonzero(r[..., 1]) == 0
+    constant = v[:, :1].expand(-1, 3, -1)
+    torch.testing.assert_close(token_energy_features(constant, constant), torch.zeros_like(r), atol=1e-12, rtol=0)
+
+
+@pytest.mark.parametrize('update', [{'K': 0}, {'coefficient_activation': 'softmax'}, {'learnable_coefficients': False}])
+def test_energy_mode_rejects_incompatible_filter_settings(update):
+    with pytest.raises(ValueError, match='token_energy'):
+        energy_filter(**update)
+
+
+def test_energy_identity_graph_retains_the_zero_sum_constraint():
+    module = energy_filter()
+    activate_energy(module)
+    v = torch.randn(2, 4, 3, dtype=torch.float64)
+    a = torch.eye(4, dtype=torch.float64).expand(2, -1, -1)
+    torch.testing.assert_close(module(a, v), module.alpha_logits.sum() * v, atol=1e-12, rtol=1e-12)
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason='CUDA unavailable')
+def test_energy_routing_cuda_amp_has_finite_backward():
+    model = AGFL(settings(coefficient_conditioning='token_energy')).cuda()
+    for f in model.filters:
+        activate_energy(f)
+    x = torch.randn(2, 7, 32, device='cuda', requires_grad=True)
+    with torch.autocast('cuda', dtype=torch.float16):
+        output = model(x)
+    output.float().square().mean().backward()
+    assert torch.isfinite(output).all() and torch.isfinite(x.grad).all()
+    assert all(p.grad is None or torch.isfinite(p.grad).all() for p in model.parameters())

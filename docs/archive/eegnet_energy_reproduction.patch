 from torch import nn
 from torch.nn import functional as F
 
+TOKEN_CONDITIONING = frozenset({'token_contrast', 'feature_contrast', 'token_energy'})
+TOKEN_ENERGY_EPS = 1e-6
+
+
+def token_energy_features(values, first_hop):
+    """Two bounded, within-trial descriptors; never EEG band-power estimates.
+
+    Inputs are [batch, token, feature]. Reductions use features and then
+    tokens, never examples. Promote before squares/subtraction under AMP;
+    preserve float64 for numerical-reference calculations.
+    """
+    if values.ndim != 3 or first_hop.shape != values.shape:
+        raise ValueError('Token energy inputs must have matching [batch, token, feature] shapes')
+    with torch.autocast(device_type=values.device.type, enabled=False):
+        working = values if values.dtype == torch.float64 else values.float()
+        first = first_hop.to(working.dtype)
+        energy = working.square().mean(dim=-1)
+        first_energy = first.square().mean(dim=-1)
+        log_energy = (energy + TOKEN_ENERGY_EPS).log()
+        relative_energy = (log_energy - log_energy.mean(dim=-1, keepdim=True)).tanh()
+        contrast = (first - working).square().mean(dim=-1)
+        strength = contrast / (2 * (energy + first_energy) + TOKEN_ENERGY_EPS)
+        centered_strength = strength - strength.mean(dim=-1, keepdim=True)
+        return torch.stack((relative_energy, centered_strength), dim=-1)
 
 

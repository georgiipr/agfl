+"""Saved token-energy inputs, effects and plots; target-machine checks only."""
+import json
+
+import numpy as np
+import pytest
+import torch
+
+from agfl.attention.agfl.layer import AGFL
+from agfl.visualization.diagnostics import coefficient_conditioning_figures, filter_figures
+from tests.test_agfl_token_diagnostics import TokenWriter, capture_tokens, token_values
+from tests.test_agfl_token_energy import activate_energy
+from tests.test_agfl_token_routing import settings
+
+
+@pytest.mark.parametrize('dtype', [torch.float32, torch.float64])
+@pytest.mark.parametrize('variant', ['polynomial', 'renormalized'])
+def test_energy_capture_saves_each_input_and_counterfactual_without_mutating_checkpoint(tmp_path, dtype, variant):
+    options = settings(dim=4, heads=2, top_k=None, coefficient_conditioning='token_energy', agfl_variant=variant)
+    model = torch.nn.ModuleDict({'attention': AGFL(options)}).to(dtype=dtype).eval()
+    with torch.no_grad():
+        model['attention'].qkv.weight.zero_()
+        model['attention'].qkv.bias.zero_()
+        model['attention'].qkv.weight[8:].copy_(torch.eye(4, dtype=dtype))
+        for item in model['attention'].filters:
+            activate_energy(item)
+    control = torch.nn.ModuleDict({'attention': AGFL({**options, 'coefficient_conditioning': 'token_contrast'})}).to(dtype=dtype).eval()
+    control.load_state_dict({name: value for name, value in model.state_dict().items() if '.energy_gate.' not in name})
+    values, ids, labels = token_values().to(dtype=dtype), ['z', 'a', 'q', 'b', 'm'], [0, 1, 2, 3, 0]
+    expected_features, expected_without = [], []
+    with torch.no_grad():
+        for head, f in enumerate(control['attention'].filters):
+            v = values[..., head * 2:(head + 1) * 2]
+            a = torch.full((5, 3, 3), 1/3, dtype=dtype)
+            one = a @ v
+            if variant == 'renormalized':
+                one = one * (v.norm(dim=-1, keepdim=True) / (one.norm(dim=-1, keepdim=True) + 1e-6))
+            # Independent NumPy descriptor from the known V and first hop.
+            v_np, p_np = v.numpy().astype(float), one.numpy().astype(float)
+            e, p = (v_np ** 2).mean(-1), (p_np ** 2).mean(-1)
+            log_e = np.log(e + 1e-6)
+            strength = ((p_np - v_np) ** 2).mean(-1) / (2 * (e + p) + 1e-6)
+            expected_features.append(np.stack((np.tanh(log_e - log_e.mean(-1, keepdims=True)),
+                                               strength - strength.mean(-1, keepdims=True)), -1))
+            expected_without.append(f.coefficient_values(v, first_hop=one).numpy())
+        expected_output = model['attention'](values).clone()
+    before = {name: value.clone() for name, value in model.state_dict().items()}
+    rng = torch.get_rng_state().clone()
+    capture = capture_tokens(model, values, ids)
+    writer = TokenWriter(tmp_path)
+    summary = coefficient_conditioning_figures(writer, capture, ids, labels, 'validation')
+    assert summary['schema_version'] == 4
+    assert json.loads(json.dumps(summary, allow_nan=False)) == summary
+    layer = summary['layers']['attention']
+    assert layer['coefficient_array_axes'] == ['trial', 'head', 'token', 'hop']
+    assert layer['energy_feature_names'] == ['relative_log_energy', 'centered_contrast_strength']
+    assert layer['energy_gate_weights_axes'] == ['head', 'hop', 'energy_feature']
+    assert type(layer['energy_descriptor_epsilon']) is float
+    with np.load(tmp_path / layer['array_file'], allow_pickle=False) as z:
+        np.testing.assert_array_equal(z['sample_ids'], ids)
+        np.testing.assert_allclose(z['energy_features'], np.stack(expected_features, 1), atol=2e-6, rtol=1e-6)
+        np.testing.assert_allclose(z['coefficients_without_energy'], np.stack(expected_without, 1), atol=2e-6)
+        expected_logits = np.einsum('bhti,hki->bhtk', z['energy_features'], z['energy_gate_weights'])
+        np.testing.assert_allclose(z['energy_gate_logits'], expected_logits, atol=2e-6)
+        np.testing.assert_allclose(z['energy_coefficient_effect'], z['effective_coefficients'] - z['coefficients_without_energy'], atol=2e-7)
+        assert z['energy_coefficient_effect'].shape == (5, 2, 3, 3)
+        assert np.abs(z['energy_coefficient_effect']).max() > .001
+        np.testing.assert_allclose(z['energy_coefficient_effect'].sum(-1), 0, atol=2e-6)
+        for head in range(2):
+            assert layer['heads'][head]['energy_gate_frobenius_norm'] > 0
+            assert layer['heads'][head]['energy_coefficient_effect_max_absolute'] > .001
+            np.testing.assert_allclose(writer.axes[2 + 2*head][0, 0].imshow.call_args.args[0],
+                                       z['energy_features'][:, head, :, 0])
+            np.testing.assert_allclose(writer.axes[3 + 2*head][1, 1].imshow.call_args.args[0],
+                                       z['energy_coefficient_effect'][:, head, :, 1])
+    assert len(writer.figures) == 6
+    assert sum('_energy_inputs_' in f['name'] for f in writer.figures) == 2
+    assert sum('_energy_effect_' in f['name'] for f in writer.figures) == 2
+    assert filter_figures(writer, model)['attention']['coefficient_scope'] == 'base_before_token_adjustment'
+    for name, value in model.state_dict().items():
+        torch.testing.assert_close(value, before[name], atol=0, rtol=0)
+    assert torch.equal(torch.get_rng_state(), rng)
+    assert all(p.grad is None for p in model.parameters())
+    with torch.no_grad():
+        torch.testing.assert_close(model['attention'](values), expected_output, atol=0, rtol=0)
+
+
+def test_zero_energy_gate_is_reported_as_zero_effect(tmp_path):
+    model = torch.nn.ModuleDict({'attention': AGFL(settings(dim=4, heads=2, coefficient_conditioning='token_energy'))}).double().eval()
+    ids = ['a', 'b', 'c', 'd', 'e']
+    capture = capture_tokens(model, token_values(), ids)
+    writer = TokenWriter(tmp_path)
+    summary = coefficient_conditioning_figures(writer, capture, ids, [0, 1, 2, 3, 0], 'validation')
+    layer = summary['layers']['attention']
+    with np.load(tmp_path / layer['array_file'], allow_pickle=False) as z:
+        assert not np.count_nonzero(z['energy_gate_logits'])
+        assert not np.count_nonzero(z['energy_coefficient_effect'])
+    assert all(h['energy_gate_frobenius_norm'] == 0 for h in layer['heads'])

+    with np.load(path.with_name('predictions.npz'), allow_pickle=False) as z:
+        for key, value in saved.items(): np.testing.assert_array_equal(z[key], value)
+    assert path.with_name('checkpoint.pt').read_bytes() == checkpoint_bytes

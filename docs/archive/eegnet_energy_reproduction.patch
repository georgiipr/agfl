+def test_energy_preset_retains_recipe_and_controls_with_only_24_added_weights():
+    old, new = load_preset('eegnet-a03-token-agfl'), load_preset('eegnet-a03-token-energy')
+    assert new['base'] == {**old['base'], 'output_dir': 'results/eegnet-A03-token-energy-v1'}
+    assert [new['experiments'][0], *new['experiments'][2:]] == old['experiments'][1:]
+    expected = deepcopy(old['experiments'][1])
+    expected['attention_options']['coefficient_conditioning'] = 'token_energy'
+    assert new['experiments'][1] == expected
+    configs = [resolve_experiments(merge(new['base'], arm))[0] for arm in new['experiments']]
+    assert len({comparison_identity(c) for c in configs}) == 1
+    assert len({experiment_identity(c) for c in configs}) == 4
+    assert sum(len(c['seeds']) for c in configs) == 20
+    assert {c['subject_id'] for c in configs} == {'A03'}
+    assert all(c['training']['epochs'] == 250 and 'sam_rho' not in c['training'] for c in configs)
+    metadata = {'channels': 22, 'samples': 1000, 'num_classes': 4, 'modality': 'eeg'}
+    counts = []
+    for config in configs:
+        model = get_model_spec('eegnet').build(config['model_options'], metadata, config['attention'], config['attention_options'])
+        counts.append(sum(p.numel() for p in model.parameters()))
+        assert model.num_tokens == 7
+    assert counts == [8244, 8268, 8036, 8260]
+
+
+def test_energy_report_pairs_original_token_and_baselines_on_exact_splits(tmp_path):
+    ids = {}
+    for seed in range(3):
+        for name, attention, score, options in [
+            ('token', 'agfl', .81, {'coefficient_conditioning': 'token_contrast'}),
+            ('energy', 'agfl', .82, {'coefficient_conditioning': 'token_energy'}),
+            ('mha', 'mha', .83, {}), ('linformer', 'linformer', .84, {'projection_rank': 4}),
+        ]:
+            record = save_comparison(tmp_path / 'runs', name, attention, seed, score, options=options,
+                                      split='unmatched' if name == 'token' and seed == 2 else None)
+            ids[name] = record['experiment_id']
+    result = analyze_results(tmp_path / 'runs', tmp_path / 'report')
+    rows = [r for r in result['comparisons'] if r['agfl_experiment_id'] == ids['energy']]
+    assert len(rows) == 9 and len(result['experiments']) == 4
+    expected = {ids['token']: (2, .01), ids['mha']: (3, -.01), ids['linformer']: (3, -.02)}
+    for row in rows:
+        n, delta = expected[row['baseline_experiment_id']]
+        assert row['n_pairs'] == n and row['mean_delta'] == pytest.approx(delta)
+        assert row['agfl_label'] == 'AGFL (token energy routing, scale 0.5)'
+        assert row['comparison_kind'] == ('coefficient_conditioning' if row['baseline'] == 'agfl' else 'attention')
+    assert attention_display_name('agfl', {'coefficient_conditioning': 'token_contrast'}) == 'AGFL (token routing, scale 0.5)'

+from tests.test_training_ema import tiny_ema_config
+
+
+@pytest.mark.parametrize('rho', [-.1, float('nan'), float('inf'), True, '.05', None])
+def test_invalid_sam_radius_is_rejected(rho):
+    with pytest.raises(ValueError, match='sam_rho'):
+        resolve_config({'training': {'sam_rho': rho}})
+
+
+def test_sam_is_off_by_default_and_rejects_unsupported_amp_device():
+    assert resolve_config({})['training']['sam_rho'] == 0
+    for update in ({'training': {'sam_rho': .05, 'amp': True}},
+                   {'device': 'mps', 'training': {'sam_rho': .05}}):
+        with pytest.raises(ValueError, match='SAM requires'):
+            resolve_config(update)
+
+
+def test_sam_off_keeps_the_ordinary_path_and_history(tmp_path, monkeypatch):
+    import agfl.sam
+    def forbidden(*args, **kwargs):
+        raise AssertionError('Ordinary training must never enter the SAM update')
+    monkeypatch.setattr(agfl.sam, 'sam_training_step', forbidden)
+    config = tiny_ema_config(tmp_path, decay=0)
+    config['training'].update(epochs=1, sam_rho=0)
+    result = run_experiment(config)[0]
+    history_path = next((tmp_path / 'results' / 'artifacts').rglob('history.json'))
+    assert all('sam' not in row for row in json.loads(history_path.read_text()))
+    assert 'sam_rho' not in result['checkpoint_policy']
+
+
+@pytest.mark.parametrize('attention', ['agfl', 'mha', 'linformer'])
+def test_sam_checkpoint_is_unperturbed_replayable_and_records_single_updates(tmp_path, attention):
+    config = tiny_ema_config(tmp_path, decay=0)
+    config['attention'] = attention
+    config['training'].update(epochs=2, sam_rho=.05, checkpoint_tiebreaker='none')
+    if attention == 'agfl':
+        config['attention_options'].update(projection='qkv', qkv_bias=True,
+            filter_projection='none', coefficient_init='one_hop', score_scaling='sqrt_dim',
+            coefficient_conditioning='token_contrast')
+    elif attention == 'linformer':
+        config['attention_options']['projection_rank'] = 4
+    result = run_experiment(config)[0]
+    path = next((tmp_path / 'results' / 'artifacts').rglob('result.json'))
+    split = json.loads(path.with_name('split.json').read_text())
+    history = json.loads(path.with_name('history.json').read_text())
+    steps = math.ceil(len(split['train']) / config['training']['batch_size'])
+    for row in history:
+        assert row['sam']['updates'] == row['epoch'] * steps
+        assert math.isfinite(row['sam']['perturbed_train_loss'])
+        assert row['checkpoint_policy']['sam_buffers'] == 'first_pass_only'
+        assert row['checkpoint_policy']['sam_randomness'] == 'replayed'
+        assert row['amp_skipped_steps'] == 0
+    selected = max(history, key=lambda row: row['validation']['accuracy'])
+    assert result['checkpoint_policy']['sam_updates'] == selected['epoch'] * steps
+    assert result['checkpoint_policy']['weights'] == 'raw'
+    checkpoint_path = path.with_name('checkpoint.pt')
+    checkpoint_bytes = checkpoint_path.read_bytes()
+    checkpoint = torch.load(checkpoint_path, map_location='cpu', weights_only=False)
+    assert checkpoint['validation'] == result['validation']
+    with np.load(path.with_name('predictions.npz'), allow_pickle=False) as z:
+        saved = {key: z[key].copy() for key in z.files}
+    bundle = load_dataset(result['config']['dataset'], result['config']['data'])
+    replay = evaluate_saved_checkpoint(deepcopy(result['config']), bundle, split, path.parent)
+    assert replay['validation'] == result['validation'] and replay['test'] == result['test']
+    with np.load(path.with_name('predictions.npz'), allow_pickle=False) as z:
+        for key, value in saved.items():
+            np.testing.assert_array_equal(z[key], value)
+    assert checkpoint_path.read_bytes() == checkpoint_bytes

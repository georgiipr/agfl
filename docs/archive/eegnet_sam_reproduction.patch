+"""Matched SAM treatment and plot/report contracts; target-machine checks only."""
+from copy import deepcopy
+
+import pytest
+
+from agfl.analysis import analyze_results, configuration_display_name, sam_control
+from agfl.config import comparison_identity, experiment_identity, merge, resolve_config, resolve_experiments
+from agfl.presets import load_preset
+from agfl.visualization.results import paired_differences, selection_label
+from tests.test_analysis import save_run
+
+
+def test_sam_preset_keeps_token_backbone_recipe_and_matches_baseline_training():
+    old, current = load_preset('eegnet-a03-token-agfl'), load_preset('eegnet-a03-token-sam')
+    expected = deepcopy(old['base'])
+    expected['output_dir'] = 'results/eegnet-A03-token-sam-v1'
+    expected['training']['sam_rho'] = .05
+    assert current['base'] == expected
+    control, candidate, mha, linformer = current['experiments']
+    assert control == {**old['experiments'][1], 'training': {'sam_rho': 0.0}}
+    assert [candidate, mha, linformer] == old['experiments'][1:]
+    configs = [resolve_experiments(merge(current['base'], e))[0] for e in current['experiments']]
+    assert len({experiment_identity(c) for c in configs}) == 4
+    assert len({comparison_identity(c) for c in configs[1:]}) == 1
+    assert comparison_identity(configs[0]) != comparison_identity(configs[1])
+    assert sum(len(c['seeds']) for c in configs) == 20
+    assert {c['subject_id'] for c in configs} == {'A03'}
+    assert sam_control(configs[1], configs[0])
+    assert not sam_control(configs[0], configs[1])
+
+
+def save_arm(root, name, attention, seed, score, rho, **overrides):
+    config = resolve_config({'dataset': 'synthetic_eeg', 'model': 'eegnet', 'attention': attention,
+                             'device': 'cpu', 'training': {'sam_rho': rho},
+                             'attention_options': ({'coefficient_conditioning': 'token_contrast'}
+                                                   if attention == 'agfl' else
+                                                   {'projection_rank': 4} if attention == 'linformer' else {})})
+    return save_run(root / name, attention, seed, score,
+                    attention_options=config['attention_options'], training=config['training'],
+                    subject_id='A03', **overrides)
+
+
+def test_report_and_plot_pairs_separate_sam_ablation_from_attention_effect(tmp_path):
+    runs = {name: [] for name in ['control', 'candidate', 'mha', 'linformer']}
+    for seed in range(3):
+        for name, attention, score, rho in [
+            ('control', 'agfl', .80, 0), ('candidate', 'agfl', .82, .05),
+            ('mha', 'mha', .81, .05), ('linformer', 'linformer', .83, .05),
+        ]:
+            runs[name].append(save_arm(tmp_path / 'runs', name, attention, seed, score, rho,
+                                      split='mismatched' if name == 'control' and seed == 2 else None))
+    result = analyze_results(tmp_path / 'runs', tmp_path / 'report')
+    ids = {name: values[0]['experiment_id'] for name, values in runs.items()}
+    assert len(result['experiments']) == 4 and len(result['comparisons']) == 9
+    for row in result['comparisons']:
+        assert row['agfl_experiment_id'] == ids['candidate']
+        control = row['baseline_experiment_id'] == ids['control']
+        assert row['comparison_kind'] == ('training_sam' if control else 'attention')
+        assert (row['comparison_id'] == row['baseline_comparison_id']) != control
+        assert row['n_pairs'] == (2 if control else 3)
+        name = next(name for name, identity in ids.items() if identity == row['baseline_experiment_id'])
+        pairs = paired_differences(runs['candidate'], runs[name], row['metric'], row['comparison_kind'])
+        assert len(pairs) == row['n_pairs']
+        assert sum(delta for _, delta in pairs) / len(pairs) == pytest.approx(row['mean_delta'])
+    assert paired_differences(runs['candidate'], runs['control'], 'accuracy') == []
+    assert paired_differences(runs['control'], runs['mha'], 'accuracy') == []
+    assert len({selection_label(values[0]) for values in runs.values()}) == 4
+    assert len({row['attention_label'] for row in result['experiments']}) == 4
+    assert 'SAM (rho 0.05)' in configuration_display_name(runs['candidate'][0]['config'])
+
+
+@pytest.mark.parametrize('field,value', [
+    ('training.learning_rate', .0009), ('training.loss', 'cross_entropy'),
+    ('training.sam_rho', .01), ('attention_options.coefficient_conditioning_scale', .25),
+    ('model_options.dropout_rate', .1), ('subject_id', 'A04'),
+    ('data.subjects', [4]), ('dataset_fingerprint', 'different-data'),
+    ('provenance.source_sha256', 'different-source'),
+    ('provenance.packages.torch', 'different-version'),
+])
+def test_sam_ablation_rejects_other_recipe_or_provenance_changes(tmp_path, field, value):
+    candidate = save_arm(tmp_path / 'runs', 'candidate', 'agfl', 0, .82, .05)
+    control = save_arm(tmp_path / 'runs', 'control', 'agfl', 0, .80, 0)
+    candidate['config']['provenance'] = {'source_sha256': 'same', 'packages': {'torch': 'same'}}
+    control['config']['provenance'] = deepcopy(candidate['config']['provenance'])
+    assert sam_control(candidate['config'], control['config'])
+    target = control['config']
+    parts = field.split('.')
+    for key in parts[:-1]:
+        target = target[key]
+    target[parts[-1]] = value
+    assert not sam_control(candidate['config'], control['config'])
+    assert paired_differences([candidate], [control], 'accuracy', 'training_sam') == []
+
+
+def test_old_sam_off_config_can_be_compared_without_rewriting_saved_identity(tmp_path):
+    candidate = save_arm(tmp_path, 'candidate', 'agfl', 0, .82, .05)['config']
+    control = save_arm(tmp_path, 'control', 'agfl', 0, .80, 0)['config']
+    del control['training']['sam_rho']
+    original = deepcopy(control)
+    assert sam_control(candidate, control)
+    assert control == original

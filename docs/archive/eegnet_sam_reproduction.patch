+"""Opt-in two-pass SAM updates using an existing single-device optimizer.
+
+No optimizer state or inference wrapper is introduced. BatchNorm and other
+buffers retain the first pass's state. The second pass replays the first
+pass's RNG so dropout does not change the sampled objective between passes.
+"""
+from contextlib import contextmanager
+import math
+import random
+
+import numpy as np
+import torch
+
+
+def _snapshot(tensors):
+    return [(tensor, tensor.detach().clone()) for tensor in tensors]
+
+
+@torch.no_grad()
+def _restore(snapshot):
+    for tensor, saved in snapshot:
+        tensor.copy_(saved)
+
+
+def _rng_state(device):
+    return (torch.get_rng_state(),
+            torch.cuda.get_rng_state(device) if device.type == 'cuda' else None,
+            random.getstate(), np.random.get_state())
+
+
+def _set_rng_state(state, device):
+    cpu, cuda, python, numpy = state
+    torch.set_rng_state(cpu)
+    if cuda is not None:
+        torch.cuda.set_rng_state(cuda, device)
+    random.setstate(python)
+    np.random.set_state(numpy)
+
+
+@contextmanager
+def _replay_rng(state, device):
+    after_first_pass = _rng_state(device)
+    try:
+        _set_rng_state(state, device)
+        yield
+    finally:
+        # Success consumes only one pass's random draws in the outer stream.
+        _set_rng_state(after_first_pass, device)
+
+
+def _gradient_norm(parameters):
+    gradients = [p.grad.detach() for p in parameters if p.grad is not None]
+    if not gradients:
+        raise RuntimeError('SAM requires at least one parameter gradient')
+    if any(g.is_sparse for g in gradients):
+        raise ValueError('SAM does not support sparse gradients')
+    norm = torch.linalg.vector_norm(torch.stack([torch.linalg.vector_norm(g) for g in gradients]))
+    if not torch.isfinite(norm):
+        raise FloatingPointError('Nonfinite SAM gradient norm')
+    return norm
+
+
+def sam_training_step(model, optimizer, inputs, targets, loss_fn, rho, gradient_clip=None):
+    """Perform one SAM/base-optimizer update; return detached pass metrics.
+
+    The first gradient defines epsilon = rho*g/(||g||_2 + 1e-12). The second
+    gradient is evaluated at w+epsilon on the same batch and random masks.
+    Original weights are copied back exactly before optimizer.step(), so
+    AdamW's decay/moments apply once, to w. Max-norm projection and EMA belong
+    to the caller, after that real update. AMP is deliberately unsupported.
+    """
+    if type(rho) not in (int, float) or not math.isfinite(rho) or rho <= 0:
+        raise ValueError('SAM rho must be finite and positive')
+    device = inputs.device
+    parameters = [p for p in model.parameters() if p.requires_grad]
+    if (device.type not in {'cpu', 'cuda'} or not parameters
+            or any(p.device != device or p.dtype not in {torch.float32, torch.float64} for p in parameters)):
+        raise ValueError('SAM requires float32/float64 parameters on one CPU or CUDA device')
+    if torch.is_autocast_enabled(device.type):
+        raise ValueError('SAM requires autocast disabled')
+    if gradient_clip is not None and (type(gradient_clip) not in (int, float)
+                                     or not math.isfinite(gradient_clip) or gradient_clip <= 0):
+        raise ValueError('SAM gradient_clip must be finite and positive')
+    original_weights = _snapshot(parameters)
+    original_buffers = _snapshot(model.buffers())
+    before_first_pass = _rng_state(device)
+    optimizer.zero_grad(set_to_none=True)
+    try:
+        logits = model(inputs)
+        loss = loss_fn(logits, targets)
+        if not torch.isfinite(loss):
+            raise FloatingPointError('Nonfinite SAM first-pass loss')
+        loss.backward()
+        norm = _gradient_norm(parameters)
+        first_pass_buffers = _snapshot(model.buffers())
+        try:
+            with torch.no_grad():
+                scale = rho / (norm + 1e-12)
+                for parameter in parameters:
+                    if parameter.grad is not None:
+                        parameter.add_(parameter.grad * scale)
+            optimizer.zero_grad(set_to_none=True)
+            with _replay_rng(before_first_pass, device):
+                perturbed_loss = loss_fn(model(inputs), targets)
+                if not torch.isfinite(perturbed_loss):
+                    raise FloatingPointError('Nonfinite SAM second-pass loss')
+                perturbed_loss.backward()
+            _gradient_norm(parameters)  # Reject nonfinite second-pass gradients.
+            if gradient_clip is not None:
+                torch.nn.utils.clip_grad_norm_(parameters, gradient_clip, error_if_nonfinite=True)
+        finally:
+            # Restore even parameters unused by the second pass. Subtraction
+            # of epsilon would introduce roundoff drift over repeated steps.
+            _restore(original_weights)
+            # Keep training-mode batch statistics in both passes, but retain
+            # only the unperturbed pass's running stats and integer counters.
+            _restore(first_pass_buffers)
+    except BaseException:
+        _restore(original_weights)
+        _restore(original_buffers)
+        _set_rng_state(before_first_pass, device)
+        optimizer.zero_grad(set_to_none=True)
+        raise
+    # No base-optimizer mutation occurs if either forward/backward pass fails.
+    optimizer.step()
+    return logits.detach(), loss.detach(), perturbed_loss.detach()

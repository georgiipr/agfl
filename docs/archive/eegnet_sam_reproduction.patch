+"""Two-pass optimizer invariants; execute only on the experiment machine."""
+from copy import deepcopy
+import random
+
+import numpy as np
+import pytest
+import torch
+from torch import nn
+
+from agfl.sam import sam_training_step
+
+
+class Quadratic(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.weight = nn.Parameter(torch.tensor([1., -2., .3], dtype=torch.float64))
+        self.frozen = nn.Parameter(torch.tensor(7., dtype=torch.float64), requires_grad=False)
+
+    def forward(self, inputs):
+        return self.weight * inputs
+
+
+class CheckingAdamW(torch.optim.AdamW):
+    def __init__(self, parameters, **kwargs):
+        super().__init__(parameters, **kwargs)
+        self.expected, self.calls = [], 0
+
+    def step(self, closure=None):
+        for parameter, original in self.expected:
+            torch.testing.assert_close(parameter, original, rtol=0, atol=0)
+        self.calls += 1
+        return super().step(closure)
+
+
+@pytest.mark.parametrize('clip', [None, .2])
+def test_sam_matches_analytic_gradient_and_one_adamw_update_after_exact_restoration(clip):
+    model, reference = Quadratic(), Quadratic()
+    optimizer = CheckingAdamW(model.parameters(), lr=.01, weight_decay=.03)
+    expected_optimizer = torch.optim.AdamW(reference.parameters(), lr=.01, weight_decay=.03)
+    inputs, target = torch.ones(3, dtype=torch.float64), torch.tensor([.1, -.2, .5], dtype=torch.float64)
+    loss_fn = lambda prediction, truth: .5 * (prediction - truth).square().sum()
+    for step in range(3):
+        original = reference.weight.detach().clone()
+        gradient = original - target
+        epsilon = .05 * gradient / (gradient.norm() + 1e-12)
+        expected_optimizer.zero_grad(set_to_none=True)
+        reference.weight.grad = gradient + epsilon
+        if clip is not None:
+            nn.utils.clip_grad_norm_(reference.parameters(), clip, error_if_nonfinite=True)
+        expected_optimizer.step()
+        optimizer.expected = [(p, p.detach().clone()) for p in model.parameters()]
+        logits, clean, perturbed = sam_training_step(model, optimizer, inputs, target, loss_fn, .05, clip)
+        assert optimizer.calls == step + 1
+        torch.testing.assert_close(logits, original, rtol=0, atol=0)
+        torch.testing.assert_close(clean, loss_fn(original, target))
+        torch.testing.assert_close(perturbed, loss_fn(original + epsilon, target))
+        torch.testing.assert_close(model.weight, reference.weight, rtol=1e-12, atol=1e-12)
+        for key, expected in expected_optimizer.state[reference.weight].items():
+            torch.testing.assert_close(optimizer.state[model.weight][key], expected, rtol=1e-12, atol=1e-12)
+        assert model.frozen == 7. and model.frozen.grad is None
+
+
+def test_zero_norm_still_performs_one_finite_adamw_update():
+    model = Quadratic()
+    original = model.weight.detach().clone()
+    optimizer = torch.optim.AdamW(model.parameters(), lr=.1, weight_decay=.2)
+    sam_training_step(model, optimizer, torch.ones(3, dtype=torch.float64), original,
+                      lambda a, b: (a - b).square().sum(), .05)
+    torch.testing.assert_close(model.weight, original * .98, rtol=0, atol=0)
+    assert optimizer.state[model.weight]['step'] == 1
+
+
+class StochasticProbe(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.bn = nn.BatchNorm1d(4, momentum=.17)
+        self.dropout = nn.Dropout(.5)
+        self.linear = nn.Linear(4, 2)
+        self.records = []
+
+    def forward(self, inputs):
+        normalized = self.bn(inputs)
+        dropped = self.dropout(normalized)
+        self.records.append({'mask': (dropped == 0).detach().clone(),
+                             'python': random.random(), 'numpy': np.random.random(),
+                             'buffers': {name: value.clone() for name, value in self.named_buffers()}})
+        return self.linear(dropped)
+
+
+@pytest.mark.parametrize('device', ['cpu', 'cuda'])
+def test_second_pass_replays_random_masks_and_retains_only_first_pass_batchnorm(device):
+    if device == 'cuda' and not torch.cuda.is_available():
+        pytest.skip('CUDA unavailable')
+    model = StochasticProbe().to(device).train()
+    reference = deepcopy(model)
+    x, y = torch.randn(7, 4, device=device), torch.tensor([0, 1, 0, 1, 0, 1, 0], device=device)
+    optimizer = torch.optim.AdamW(model.parameters(), lr=.001)
+    python, numpy = random.getstate(), np.random.get_state()
+    cpu = torch.get_rng_state()
+    cuda = torch.cuda.get_rng_state() if device == 'cuda' else None
+    nn.functional.cross_entropy(reference(x), y).backward()
+    expected_cpu = torch.get_rng_state()
+    expected_cuda = torch.cuda.get_rng_state() if device == 'cuda' else None
+    expected_python, expected_numpy = random.getstate(), np.random.get_state()
+    torch.set_rng_state(cpu)
+    if cuda is not None:
+        torch.cuda.set_rng_state(cuda)
+    random.setstate(python)
+    np.random.set_state(numpy)
+    sam_training_step(model, optimizer, x, y, nn.functional.cross_entropy, .05)
+    assert len(model.records) == 2
+    for record in model.records:
+        torch.testing.assert_close(record['mask'], reference.records[0]['mask'], rtol=0, atol=0)
+        assert record['python'] == reference.records[0]['python']
+        assert record['numpy'] == reference.records[0]['numpy']
+    for name, value in model.named_buffers():
+        torch.testing.assert_close(value, reference.records[0]['buffers'][name], rtol=0, atol=0)
+    assert model.bn.num_batches_tracked == 1 and model.bn.momentum == .17
+    assert all(module.training for module in model.modules())
+    assert torch.equal(torch.get_rng_state(), expected_cpu)
+    if expected_cuda is not None:
+        assert torch.equal(torch.cuda.get_rng_state(), expected_cuda)
+    assert random.getstate() == expected_python
+    np.testing.assert_equal(np.random.get_state(), expected_numpy)
+
+
+@pytest.mark.parametrize('failure', ['nan_first', 'nan_second', 'nan_gradient', 'exception', 'interrupt'])
+def test_failed_probe_restores_weights_buffers_rng_and_does_not_step(failure):
+    model = StochasticProbe().train()
+    optimizer = CheckingAdamW(model.parameters(), lr=.001)
+    original = deepcopy(model.state_dict())
+    x, y = torch.randn(7, 4), torch.tensor([0, 1, 0, 1, 0, 1, 0])
+    cpu, python, numpy = torch.get_rng_state(), random.getstate(), np.random.get_state()
+    calls = 0
+
+    def broken_loss(logits, targets):
+        nonlocal calls
+        calls += 1
+        if calls == 1 and failure == 'nan_first':
+            return logits.sum() * float('nan')
+        if calls == 2:
+            if failure == 'nan_second':
+                return logits.sum() * float('nan')
+            if failure == 'nan_gradient':
+                # Finite scalar, nonfinite derivative at zero.
+                return (logits.sum() * 0).sqrt()
+            if failure == 'exception':
+                raise RuntimeError('probe failed')
+            if failure == 'interrupt':
+                raise KeyboardInterrupt('probe interrupted')
+        return nn.functional.cross_entropy(logits, targets)
+
+    expected = KeyboardInterrupt if failure == 'interrupt' else RuntimeError if failure == 'exception' else FloatingPointError
+    with pytest.raises(expected):
+        sam_training_step(model, optimizer, x, y, broken_loss, .05)
+    assert optimizer.calls == 0 and not optimizer.state
+    assert all(p.grad is None for p in model.parameters())
+    for name, value in model.state_dict().items():
+        torch.testing.assert_close(value, original[name], rtol=0, atol=0)
+    assert torch.equal(torch.get_rng_state(), cpu) and random.getstate() == python
+    np.testing.assert_equal(np.random.get_state(), numpy)
+
+
+def test_parameter_unused_in_second_pass_is_still_restored():
+    class Conditional(nn.Module):
+        def __init__(self):
+            super().__init__()
+            self.a, self.b = nn.Parameter(torch.tensor(2.)), nn.Parameter(torch.tensor(3.))
+            self.calls = 0
+
+        def forward(self, x):
+            self.calls += 1
+            return (self.a + self.b if self.calls == 1 else self.a) * x
+
+    model = Conditional()
+    optimizer = torch.optim.SGD(model.parameters(), lr=.1)
+    sam_training_step(model, optimizer, torch.ones(1), torch.zeros(1), nn.functional.mse_loss, .05)
+    assert model.b.grad is None
+    torch.testing.assert_close(model.b, torch.tensor(3.), rtol=0, atol=0)

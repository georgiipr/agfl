{
  "base": {
    "dataset": "eeg",
    "model": "eegnet",
    "device": "cuda",
    "deterministic": true,
    "threads": 1,
    "seeds": [0, 1, 2, 3, 4],
    "data": {
      "data_dir": "../ml",
      "subjects": [3, 4, 9],
      "sessions": ["T"],
      "normalization": "train_channel",
      "filter_scope": "run",
      "lowcut": 2.0,
      "highcut": 30.0,
      "offset_seconds": 0.0,
      "window": 1000,
      "artifact_policy": "include"
    },
    "split": {"protocol": "stratified", "train": 0.6, "validation": 0.2, "test": 0.2},
    "model_options": {
      "attention_axis": "electrode",
      "electrode_architecture": "pre_spatial",
      "temp_kernel": 125,
      "f1": 16,
      "d": 2,
      "f2": 32,
      "pk1": 8,
      "pk2": 16,
      "dropout_rate": 0.5,
      "attention_residual": true,
      "attention_dropout": 0.0,
      "batch_norm_momentum": 0.1,
      "batch_norm_eps": 1e-05,
      "initialization": "pytorch",
      "max_norm1": 1.0,
      "max_norm2": 0.25,
      "spatial_readout": "learned",
      "temporal_statistics": "mean"
    },
    "training": {
      "epochs": 500,
      "batch_size": 64,
      "optimizer": "adamw",
      "learning_rate": 0.001,
      "weight_decay": 0.001,
      "momentum": 0.9,
      "loss": "cross_entropy",
      "class_weights": "balanced",
      "focal_gamma": 2.0,
      "checkpoint_criterion": "loss",
      "checkpoint_tiebreaker": "none",
      "scheduler": "warmup_cosine",
      "warmup_epochs": 10,
      "min_lr_ratio": 0.0,
      "gradient_clip": null,
      "early_stopping_patience": 0,
      "early_stopping_min_epochs": 0,
      "amp": false,
      "num_workers": 0,
      "augmentation": {"shift": 0, "scale": 0.0, "noise": 0.0, "recombine_segments": 0, "recombine_probability": 0.5},
      "ema_decay": 0.0,
      "save_checkpoints": true
    },
    "output_dir": "results/eegnet-A03-A04-A09-pre-spatial-v1",
    "study": {
      "name": "eegnet-A03-A04-A09-pre-spatial-v1",
      "subjects": ["A03", "A04", "A09"],
      "seeds": [0, 1, 2, 3, 4],
      "arms": ["agfl_base", "mha_base"],
      "comparisons": [["agfl_base", "mha_base"]]
    }
  },
  "experiments": [
    {
      "study_arm": "agfl_base",
      "attention": "agfl",
      "attention_options": {
        "heads": 4,
        "agfl_variant": "polynomial",
        "K": 2,
        "top_k": "scheduled",
        "top_k_stage": "scores",
        "top_k_ties": "threshold",
        "top_k_schedule": {"smax": 0.2, "smin": 0.8, "alpha": 3.0},
        "graph_normalization": "softmax",
        "post_topk_renormalize": true,
        "coefficient_activation": "identity",
        "coefficient_init": "zeros",
        "coefficient_conditioning": "static",
        "coefficient_conditioning_scale": 0.5,
        "temporal_bias": false,
        "output_gate": false,
        "learnable_coefficients": true,
        "projection": "split_input",
        "qkv_bias": false,
        "filter_projection": "separate",
        "filter_projection_init": "pytorch",
        "score_scaling": "temperature",
        "temperature_init": 1.0,
        "hop_normalization": "feature"
      }
    },
    {
      "study_arm": "mha_base",
      "attention": "mha",
      "attention_options": {"heads": 4, "temporal_bias": false, "output_gate": false}
    }
  ]
}

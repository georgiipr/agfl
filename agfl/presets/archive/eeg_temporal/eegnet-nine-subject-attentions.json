{
  "base": {
    "dataset": "eeg",
    "model": "eegnet",
    "device": "cuda",
    "deterministic": true,
    "threads": 1,
    "seeds": [
      0,
      1,
      2,
      3,
      4
    ],
    "data": {
      "data_dir": "../ml",
      "subjects": [
        1,
        2,
        3,
        4,
        5,
        6,
        7,
        8,
        9
      ],
      "sessions": [
        "T"
      ],
      "normalization": "train_channel",
      "filter_scope": "trial",
      "lowcut": 2.0,
      "highcut": 30.0,
      "offset_seconds": 0.0,
      "window": 1000,
      "artifact_policy": "exclude"
    },
    "split": {
      "protocol": "stratified",
      "train": 0.6,
      "validation": 0.2,
      "test": 0.2
    },
    "model_options": {
      "attention_axis": "time",
      "temp_kernel": 32,
      "f1": 16,
      "d": 2,
      "f2": 32,
      "pk1": 8,
      "pk2": 16,
      "dropout_rate": 0.5,
      "attention_residual": true,
      "attention_dropout": 0.0,
      "batch_norm_momentum": 0.1,
      "batch_norm_eps": 1e-05,
      "initialization": "pytorch",
      "max_norm1": 1.0,
      "max_norm2": 0.25,
      "spatial_readout": "learned",
      "temporal_statistics": "mean"
    },
    "attention_options": {
      "heads": 4
    },
    "training": {
      "epochs": 250,
      "batch_size": 64,
      "optimizer": "adamw",
      "learning_rate": 0.005,
      "weight_decay": 0.001,
      "momentum": 0.9,
      "loss": "focal",
      "class_weights": "balanced",
      "focal_gamma": 3.0,
      "checkpoint_criterion": "accuracy",
      "scheduler": "warmup_cosine",
      "warmup_epochs": 10,
      "min_lr_ratio": 0.0,
      "gradient_clip": null,
      "early_stopping_patience": 0,
      "early_stopping_min_epochs": 100,
      "amp": false,
      "num_workers": 0,
      "augmentation": {
        "shift": 0,
        "scale": 0.0,
        "noise": 0.0,
        "recombine_segments": 0,
        "recombine_probability": 0.5
      },
      "ema_decay": 0.0,
      "checkpoint_tiebreaker": "none"
    },
    "output_dir": "results/eegnet-nine-subject-attentions-v1",
    "study": {
      "name": "eegnet-nine-subject-attentions-v1",
      "subjects": [
        "A01",
        "A02",
        "A03",
        "A04",
        "A05",
        "A06",
        "A07",
        "A08",
        "A09"
      ],
      "seeds": [
        0,
        1,
        2,
        3,
        4
      ],
      "arms": [
        "agfl_augmented",
        "mha_augmented",
        "mha",
        "performer64",
        "linformer4",
        "linformer7",
        "nystromformer4",
        "nystromformer7"
      ]
    }
  },
  "experiments": [
    {
      "attention": "agfl",
      "attention_options": {
        "K": 2,
        "agfl_variant": "polynomial",
        "coefficient_activation": "identity",
        "coefficient_init": "one_hop",
        "filter_projection": "none",
        "graph_normalization": "softmax",
        "hop_normalization": "feature",
        "learnable_coefficients": true,
        "post_topk_renormalize": true,
        "projection": "qkv",
        "qkv_bias": true,
        "score_scaling": "sqrt_dim",
        "top_k": "scheduled",
        "top_k_schedule": {
          "alpha": 3.0,
          "smax": 0.2,
          "smin": 0.8
        },
        "top_k_stage": "scores",
        "top_k_ties": "threshold",
        "coefficient_conditioning": "token_contrast",
        "coefficient_conditioning_scale": 0.5,
        "temporal_bias": true,
        "output_gate": true
      },
      "study_arm": "agfl_augmented"
    },
    {
      "attention": "mha",
      "attention_options": {
        "temporal_bias": true,
        "output_gate": true
      },
      "study_arm": "mha_augmented"
    },
    {
      "attention": "mha",
      "attention_options": {
        "temporal_bias": false,
        "output_gate": false
      },
      "study_arm": "mha"
    },
    {
      "attention": "performer",
      "attention_options": {
        "random_features": 64
      },
      "study_arm": "performer64"
    },
    {
      "attention": "linformer",
      "attention_options": {
        "projection_rank": 4
      },
      "study_arm": "linformer4"
    },
    {
      "attention": "linformer",
      "attention_options": {
        "projection_rank": 7
      },
      "study_arm": "linformer7"
    },
    {
      "attention": "nystromformer",
      "attention_options": {
        "landmarks": 4,
        "pinv_rtol": 1e-05
      },
      "study_arm": "nystromformer4"
    },
    {
      "attention": "nystromformer",
      "attention_options": {
        "landmarks": 7,
        "pinv_rtol": 1e-05
      },
      "study_arm": "nystromformer7"
    }
  ]
}

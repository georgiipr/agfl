{
  "base": {
    "dataset": "si_hom",
    "device": "cuda",
    "deterministic": true,
    "threads": 1,
    "seeds": [
      0,
      1,
      2,
      3,
      4
    ],
    "data": {
      "subjects": [
        1,
        2,
        3,
        4,
        5,
        6,
        7
      ],
      "classes": [
        0,
        1,
        2,
        3,
        4,
        5,
        6,
        7
      ],
      "cohort": "pooled",
      "start": 0,
      "window": 500,
      "normalization": "train_channel"
    },
    "split": {
      "protocol": "stratified",
      "train": 0.6,
      "validation": 0.2,
      "test": 0.2
    },
    "training": {
      "epochs": 200,
      "batch_size": 64,
      "optimizer": "adamw",
      "learning_rate": 0.001,
      "weight_decay": 0.001,
      "momentum": 0.9,
      "loss": "cross_entropy",
      "class_weights": "balanced",
      "focal_gamma": 2.0,
      "scheduler": "warmup_cosine",
      "warmup_epochs": 10,
      "min_lr_ratio": 0.0,
      "checkpoint_criterion": "loss",
      "checkpoint_tiebreaker": "none",
      "ema_decay": 0.0,
      "save_checkpoints": true,
      "gradient_clip": null,
      "num_workers": 0,
      "amp": false,
      "early_stopping_patience": 0,
      "early_stopping_min_epochs": 0,
      "augmentation": {
        "shift": 0,
        "scale": 0.0,
        "noise": 0.0,
        "recombine_segments": 0,
        "recombine_probability": 0.5
      }
    },
    "output_dir": "results/si-hom-signal-transformer",
    "model": "signal_transformer",
    "model_options": {
      "dim": 64,
      "depth": 2,
      "dropout": 0.1,
      "mlp_ratio": 4.0,
      "eeg_temporal_bins": 8,
      "eeg_kernel_size": 31,
      "spatial_readout": "learned"
    }
  },
  "experiments": [
    {
      "attention": "agfl",
      "attention_options": {
        "heads": 4,
        "agfl_variant": "polynomial",
        "K": 2,
        "top_k": "scheduled",
        "top_k_stage": "scores",
        "top_k_ties": "threshold",
        "top_k_schedule": {
          "smax": 0.2,
          "smin": 0.8,
          "alpha": 3.0
        },
        "graph_normalization": "softmax",
        "post_topk_renormalize": true,
        "coefficient_activation": "identity",
        "coefficient_init": "zeros",
        "coefficient_conditioning": "static",
        "coefficient_conditioning_scale": 0.5,
        "temporal_bias": false,
        "output_gate": false,
        "learnable_coefficients": true,
        "projection": "split_input",
        "qkv_bias": false,
        "filter_projection": "separate",
        "filter_projection_init": "pytorch",
        "score_scaling": "temperature",
        "temperature_init": 1.0,
        "hop_normalization": "feature"
      }
    },
    {
      "attention": "mha",
      "attention_options": {
        "heads": 4,
        "temporal_bias": false,
        "output_gate": false
      }
    },
    {
      "attention": "hcann",
      "attention_options": {
        "heads": 4,
        "dropout": 0.0,
        "pre_norm": false
      }
    }
  ]
}
